# Obrigatórias em produção online (Project Settings -> API no painel do Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Recomendada em produção no servidor (nunca exposta ao navegador)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# Exclusivo para testes locais sem Supabase configurado (ignorado quando Supabase está ativo)
ADMIN_DEMO_EMAIL=admin@rsdigital.com.br
ADMIN_DEMO_PASSWORD=rsdigital123


