# Supabase (obtenha em Project Settings -> API no painel do Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
# Opcional: com as políticas de RLS e funções RPC de supabase/schema.sql, apenas a ANON_KEY já basta
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# Opcional: Senha de acesso ao painel em modo de demonstração (quando Supabase não estiver configurado)
ADMIN_DEMO_EMAIL=admin@rsdigital.com.br
ADMIN_DEMO_PASSWORD=rsdigital123

